  "query": "\n    SELECT dh.value as hash, hs.value as strat, m.value as mime\n    FROM\n        dok_hashes dh,\n        hash_strategy hs,\n        mime m\n    WHERE\n        hs.id = dh.hash_strat_id AND\n        dh.dok_id = $1 AND\n        dh.mime_id = m.id\n        ",
