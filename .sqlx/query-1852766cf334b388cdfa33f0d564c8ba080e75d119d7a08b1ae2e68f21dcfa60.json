  "query": "SELECT k.id, k.deleted_by, k.expires_at, s.value as \"scope: APIScope\", k.salt, k.key_hash, ha.value as \"algo: HashAlgorithm\"\n            FROM api_keys k\n            INNER JOIN api_scope s ON s.id = k.scope\n            INNER JOIN hash_algorithm ha ON ha.id = k.algo\n            WHERE keytag = $1",
